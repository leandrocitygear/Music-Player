{
  "name": "disc-out",
  "productName": "Disc-out",
  "version": "1.0.0",
  "description": "A desktop music player built with Electron",
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "dist:win": "electron-builder --win --x64"
  },

  "build": {
  "appId": "com.discout.music",
  "productName": "Disc-Out",

  "directories": {
    "output": "out/msix"
  },

  "files": [
    "**/*"
  ],

  "win": {
    "target": [
      {
        "target": "msix",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "favicon_io/favicon.ico"
  },

  "msix": {
    "identityName": "com.discout.music",
    "publisher": "CN=Disc-Out",
    "publisherDisplayName": "Disc-Out",
    "applicationId": "DiscOut",
    "displayName": "Disc-Out"
  }
},

  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4"
  },
  "keywords": [],
  "author": {
    "name": "Leandro",
    "email": "leandrocitygear@icloud.com"
  },
  "license": "MIT",
  "dependencies": {
    "@audio/decode-aac": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.0",
    "jsmediatags": "^1.1.0",
    "music-metadata": "^11.15.0",
    "uuid": "^9.0.1"
  },
  "overrides": {
    "@electron/node-gyp": "latest"
  }
}
